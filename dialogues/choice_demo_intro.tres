[sub_resource type="Resource" id="Dia_Intro_1"]
script = ExtResource("1_dialogue")
content = "嘿！是你啊！
听说你搞了一套[shake rate=10 level=3]选项系统[/shake]？
[wave amp=20 freq=2]让我来检验一下！！[/wave]"
avatar = ExtResource("8_flowey")
character_name = "小花"
metadata/_custom_type_script = "uid://c06clw1acxak"

[sub_resource type="Resource" id="Dia_Intro_2"]
script = ExtResource("1_dialogue")
content = "现在你看到了两个选项。
红心是[color=#ffaa00]从文字左边滑进来[/color]的——这就是[color=#ff4444]Slide效果[/color]！
[tornado radius=4 freq=2]果冻弹入！[/tornado]
选一个，我们继续。"
avatar = ExtResource("8_flowey")
character_name = "小花"
metadata/_custom_type_script = "uid://c06clw1acxak"

[resource]
script = ExtResource("2_group")
dialogue_list = Array[ExtResource("1_dialogue")]([SubResource("Dia_Intro_1"), SubResource("Dia_Intro_2")])
