[sub_resource type="Resource" id="Resource_njmod"]
script = ExtResource("3_k28l7")
content = "*。。。。"
avatar = ExtResource("4_xvmxk")
position_up = true
metadata/_custom_type_script = "uid://c06clw1acxak"

[sub_resource type="Resource" id="Resource_8rns0"]
script = ExtResource("3_k28l7")
content = "*但是，我的孩子，
你最好还是不要想离开遗迹这件事。
行吗？"
avatar = ExtResource("7_3y7tn")
metadata/_custom_type_script = "uid://c06clw1acxak"

[sub_resource type="Resource" id="Resource_r5l33"]
script = ExtResource("3_k28l7")
content = "*就在这里快快乐乐的。"
avatar = ExtResource("8_r01nr")
metadata/_custom_type_script = "uid://c06clw1acxak"

[sub_resource type="Resource" id="Resource_0rh08"]
script = ExtResource("3_k28l7")
content = "*我可以给你做好吃的派，
念有趣的故事。"
avatar = ExtResource("8_r01nr")
metadata/_custom_type_script = "uid://c06clw1acxak"

[sub_resource type="Resource" id="Resource_gkbvp"]
script = ExtResource("3_k28l7")
content = "*你还能在遗迹的浅水塘捉青蛙玩！"
avatar = ExtResource("9_uqb46")
metadata/_custom_type_script = "uid://c06clw1acxak"

[sub_resource type="Resource" id="Resource_yhq2q"]
script = ExtResource("3_k28l7")
content = "*......"
avatar = ExtResource("10_r81mc")
metadata/_custom_type_script = "uid://c06clw1acxak"

[sub_resource type="Resource" id="Resource_7wu5a"]
script = ExtResource("3_k28l7")
content = "*......"
avatar = ExtResource("11_vqqhc")
metadata/_custom_type_script = "uid://c06clw1acxak"

[sub_resource type="Resource" id="Resource_cvw5p"]
script = ExtResource("3_k28l7")
content = "*我知道你很想离开 Ruins。"
avatar = ExtResource("12_g4x3f")
metadata/_custom_type_script = "uid://c06clw1acxak"

[sub_resource type="Resource" id="Resource_dw65b"]
script = ExtResource("3_k28l7")
content = "*但是，亲爱的..."
avatar = ExtResource("13_sxots")
metadata/_custom_type_script = "uid://c06clw1acxak"

[sub_resource type="Resource" id="Resource_3csxk"]
script = ExtResource("3_k28l7")
content = "*我真的不能让你离开。"
avatar = ExtResource("14_4hdnj")
metadata/_custom_type_script = "uid://c06clw1acxak"

[sub_resource type="Resource" id="Resource_tuidn"]
script = ExtResource("3_k28l7")
content = "*虽然这对一个孩子来说有些残酷。"
avatar = ExtResource("12_g4x3f")
metadata/_custom_type_script = "uid://c06clw1acxak"

[sub_resource type="Resource" id="Resource_xjt4s"]
script = ExtResource("3_k28l7")
content = "*但是，我希望你也能理解。"
avatar = ExtResource("13_sxots")
metadata/_custom_type_script = "uid://c06clw1acxak"

[sub_resource type="Resource" id="Resource_l0yeh"]
script = ExtResource("3_k28l7")
content = "*如果你离开了Ruins，
我就不能在保护你，
我的孩子。"
avatar = ExtResource("12_g4x3f")
metadata/_custom_type_script = "uid://c06clw1acxak"

[sub_resource type="Resource" id="Resource_wi0h3"]
script = ExtResource("3_k28l7")
content = "*你不知道，如果你离开了Ruins，
外面的怪物会对你做出什么事情。"
avatar = ExtResource("14_4hdnj")
metadata/_custom_type_script = "uid://c06clw1acxak"

[sub_resource type="Resource" id="Resource_uhbhb"]
script = ExtResource("3_k28l7")
content = "*..."
avatar = ExtResource("15_ijjuc")
metadata/_custom_type_script = "uid://c06clw1acxak"

[sub_resource type="Resource" id="Resource_8qf8r"]
script = ExtResource("3_k28l7")
content = "*......"
avatar = ExtResource("14_4hdnj")
metadata/_custom_type_script = "uid://c06clw1acxak"

[sub_resource type="Resource" id="Resource_7wo3u"]
script = ExtResource("3_k28l7")
content = "*别这样看着我，别用这种眼神..."
avatar = ExtResource("16_uqb1p")
metadata/_custom_type_script = "uid://c06clw1acxak"

[sub_resource type="Resource" id="Resource_5gg7f"]
script = ExtResource("3_k28l7")
content = "*......"
avatar = ExtResource("17_so02p")
metadata/_custom_type_script = "uid://c06clw1acxak"

[sub_resource type="Resource" id="Resource_7gxjk"]
script = ExtResource("3_k28l7")
content = "*我的孩子。我很抱歉..."
avatar = ExtResource("12_g4x3f")
metadata/_custom_type_script = "uid://c06clw1acxak"

[sub_resource type="Resource" id="Resource_jh71f"]
script = ExtResource("3_k28l7")
content = "*我很抱歉，要让你在这里长大。"
avatar = ExtResource("13_sxots")
metadata/_custom_type_script = "uid://c06clw1acxak"

[sub_resource type="Resource" id="Resource_d6rpb"]
script = ExtResource("3_k28l7")
content = "*你是对的...因为你在这里没有朋友，
也不能得到好的教育。
"
avatar = ExtResource("11_vqqhc")
metadata/_custom_type_script = "uid://c06clw1acxak"

[sub_resource type="Resource" id="Resource_p3uqr"]
script = ExtResource("3_k28l7")
content = "*如果你要离开，
我会给你准备你路上要穿衣服，鞋子，
还有要带的食物，以及其他东西。"
avatar = ExtResource("18_qq4kp")
metadata/_custom_type_script = "uid://c06clw1acxak"

[sub_resource type="Resource" id="Resource_du300"]
script = ExtResource("3_k28l7")
content = "*但是，一旦离开Ruins，
就不要再回来了。"
avatar = ExtResource("4_xvmxk")
metadata/_custom_type_script = "uid://c06clw1acxak"

[sub_resource type="Resource" id="Resource_v3rdw"]
script = ExtResource("3_k28l7")
content = "* 稍等一下，我的孩子。"
metadata/_custom_type_script = "uid://c06clw1acxak"

