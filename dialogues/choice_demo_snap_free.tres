[sub_resource type="Resource" id="Dia_Snap_1"]
script = ExtResource("1_dialogue")
content = "接来下是[color=#44aaff]Snap滑动传送[/color]。
[shake rate=15 level=4]看仔细！[/shake]
红心会在选项之间[rainbow freq=0.4 sat=10 val=20]飞过去[/rainbow]。
按方向键试试！"
avatar = ExtResource("8_flowey")
character_name = "小花"
show_on_left = true
metadata/_custom_type_script = "uid://c06clw1acxak"

[sub_resource type="Resource" id="Dia_Snap_2"]
script = ExtResource("1_dialogue")
content = "[center]←  →  ↑  ↓[/center]
来回按！快速连按[color=#44aaff]无缝衔接[/color]。
远近一样快——速度恒定的。
按够了吗？随便选一个确认。"
avatar = ExtResource("8_flowey")
character_name = "小花"
show_on_left = true
metadata/_custom_type_script = "uid://c06clw1acxak"

[resource]
script = ExtResource("2_group")
dialogue_list = Array[ExtResource("1_dialogue")]([SubResource("Dia_Snap_1"), SubResource("Dia_Snap_2")])
id = "snap_free"
next_id = "snap_blocked"
choices = Array[String](["左边", "右边", "上边", "底下"])
choice_next_ids = Array[String](["snap_blocked", "snap_blocked", "snap_blocked", "snap_blocked"])
choice_effect = SubResource("Snap_Free")
