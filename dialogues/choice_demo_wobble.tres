[sub_resource type="Resource" id="Dia_Wobble_1"]
script = ExtResource("1_dialogue")
content = "最后是[rainbow freq=0.5 sat=15 val=20]果冻摇晃[/rainbow]！
红心贴上去之后左右晃几下，幅度会衰减。
就像被摇晃了一下。[pulse freq=3 ease=-2]懂吧？[/pulse]"
