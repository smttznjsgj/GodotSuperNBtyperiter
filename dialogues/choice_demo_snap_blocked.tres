[sub_resource type="Resource" id="Snap_Blocked"]
script = ExtResource("3_snap")
speed = 120.0
overshoot = true
overshoot_amount = 4.0
block_input = true
metadata/_custom_type_script = "uid://bsko0xhx61xck"

[sub_resource type="Resource" id="Dia_Blocked_1"]
script = ExtResource("1_dialogue")
content = "现在[color=#ff4444]block_input = true[/color]。
你每次按键，红心必须滑到位才能再按。
[shake rate=5 level=2]等……它……到……位……[/shake]
适合那些[color=#888888]沉重、燃尽、安静[/color]的场景。
主角已经没力气了。只能眼睁睁看着。"
avatar = ExtResource("8_flowey")
character_name = "小花"
show_on_left = true
metadata/_custom_type_script = "uid://c06clw1acxak"

[sub_resource type="Resource" id="Dia_Blocked_2"]
script = ExtResource("1_dialogue")
content = "按一下。等一等。再按。
它慢慢挪过去。你什么都做不了。"
avatar = ExtResource("8_flowey")
character_name = "小花"
show_on_left = true
metadata/_custom_type_script = "uid://c06clw1acxak"

[resource]
script = ExtResource("2_group")
dialogue_list = Array[ExtResource("1_dialogue")]([SubResource("Dia_Blocked_1"), SubResource("Dia_Blocked_2")])
id = "snap_blocked"
next_id = "wobble"
choices = Array[String](["……我尽力试试", "……好吧", "…………", ""])
choice_next_ids = Array[String](["wobble", "wobble", "wobble", ""])
choice_effect = SubResource("Snap_Blocked")
